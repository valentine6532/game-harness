{
  "description": "게임 하네스가 적용된 프로젝트에서 작업 인계 규칙을 지키게 한다. 적용되지 않은 프로젝트에서는 아무것도 하지 않는다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/work_guard.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/work_guard.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
